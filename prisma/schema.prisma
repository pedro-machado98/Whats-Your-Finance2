// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema



generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash String

  DDDtelefone String @unique
  apelido String
  firstName String
  lastName String

  movimentacoes Movimentacao[]
  
  @@map("users")
}

model Movimentacao {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entrada_saida String
  conta String?
  valor Float
  categoria Categoria @default(GERAL)

  userId Int
  user User @relation(fields: [userId], references: [id])
  @@map("movimentacoes")
}

enum Categoria {
  GERAL
  MORADIA
  ALIMENTACAO
  TRANSPORTE
  SAUDE
  EDUCACAO
  LAZER
  DESPESAS_PESSOAIS
  ECONOMIAS
}
